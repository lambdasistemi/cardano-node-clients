+--
+-- FAULT fault-snapshot-binding: the read runs as separate
+-- transactions (markers and indexed point; asset rows; one per row
+-- join) and waits for the indexed point to move before reading the
+-- rows, so one answer binds a point, its matches and their creation
+-- points taken from different snapshots. The indexed-view core
+-- below stays single-transaction; only the legacy wrapper splits.
 readAssetSnapshot ::
+    (forall a. Transaction IO cf Cols op a -> IO a) ->
     PolicyId ->
     AssetName ->
-    Transaction IO cf Cols op (Either AssetQueryUnavailable AssetSnapshot)
-readAssetSnapshot = readAssetSnapshotCore
+    IO (Either AssetQueryUnavailable AssetSnapshot)
+readAssetSnapshot run policy name = do
+    mRebuild <- run (query MetaCol assetIndexRebuildKey)
+    mMarker <- run (query MetaCol assetIndexCompleteKey)
+    case (mRebuild, mMarker) of
+        (Just _, _) -> pure (Left AssetIndexRebuilding)
+        (Nothing, Just v) | v == assetIndexCompleteValue -> readComplete
+        _ -> pure (Left AssetIndexAbsent)
+  where
+    readComplete = do
+        mPoint <- run indexedPoint
+        case mPoint of
+            Nothing -> pure (Left NoIndexedPoint)
+            Just point -> do
+                awaitMovedPoint mPoint (2000 :: Int)
+                rows <- run (iterating AssetIndex (scanAsset policy name))
+                result <- traverse (run . matchOf) rows
+                pure (fmap (AssetSnapshot point) (sequenceA result))
+
+    awaitMovedPoint seen n =
+        when (n > 0) $ do
+            now <- run indexedPoint
+            when (now == seen) $ do
+                threadDelay 1000
+                awaitMovedPoint seen (n - 1)
+
+    matchOf (txIn, qty) = do
+        mAddr <- query TxInCol txIn
+        case mAddr of
+            Nothing -> pure (Left (AssetIndexInconsistent txIn))
+            Just addr -> do
+                mOut <- query AddressIndex (AddrKey addr txIn)
+                case mOut of
+                    Nothing -> pure (Left (AssetIndexInconsistent txIn))
+                    Just txOut -> do
+                        mObs <- query ObservationCol txIn
+                        case mObs of
+                            Nothing -> pure (Left (AssetIndexInconsistent txIn))
+                            Just (slot, bh) ->
+                                pure
+                                    ( Right
+                                        ( AssetMatch
+                                            { amTxIn = txIn
+                                            , amTxOut = txOut
+                                            , amQuantity = qty
+                                            , amCreatedSlot = slot
+                                            , amCreatedBlockHash = bh
+                                            }
+                                        )
+                                    )
 
